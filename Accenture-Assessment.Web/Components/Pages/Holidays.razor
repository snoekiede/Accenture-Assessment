@page "/holidays"
@rendermode InteractiveServer
@using System.Net
@using Accenture_Assesment.Web
@using Accenture_Assessment.Contracts.Dtos
@using Microsoft.Extensions.Logging
@inject ApplicationApiClient ApiClient
@inject ILogger<Holidays> Logger

<h3>Holidays</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" @onclick="@(() => _errorMessage = null)"></button>
    </div>
}

@if (_countries == null)
{
    <p><em>Loading countries...</em></p>
}
else if (!_countries.Any())
{
    <p>No countries available.</p>
}
else
{
    <!-- Last Celebrated Holidays Section -->
    <div class="card mb-4">
        <div class="card-header">
    <h5>Last Celebrated Holidays</h5>
 </div>
        <div class="card-body">
            <div class="mb-3">
       <label for="countrySelect" class="form-label">Select a Country:</label>
        <select id="countrySelect" class="form-select" value="@selectedCountryCode" @onchange="OnCountryChanged">
        <option value="">--- Select a country ---</option>
       @foreach (var country in _countries)
            {
       <option value="@country.countryCode">@country.name</option>
        }
 </select>
    <button class="btn btn-primary mt-2" @onclick="OnGetLastHolidays" disabled="@string.IsNullOrEmpty(selectedCountryCode)">
   Find holidays
        </button>
    </div>

 <div class="mb-3">
   @if (_results == null || !_results.Any())
                {
          <em>No results</em>
    }
          else
                {
               <h6>Last Celebrated Holidays:</h6>
            @foreach (var holiday in _results)
           {
   <div class="mb-2">
<strong>@holiday.Name</strong> (@holiday.LocalName) - @holiday.Date.ToShortDateString()
      </div>
  }
}
            </div>
        </div>
    </div>

    <!-- Public Holidays Count Section -->
    <div class="card mb-4">
      <div class="card-header">
     <h5>Public Holidays Count (Excluding Weekends)</h5>
        </div>
        <div class="card-body">
  <div class="row mb-3">
       <div class="col-md-6">
          <label for="yearInput" class="form-label">Year:</label>
  <input type="number" id="yearInput" class="form-control" @bind="selectedYear" min="2020" max="2030" />
    </div>
    </div>

          <div class="mb-3">
         <label class="form-label">Select Countries (hold Ctrl to select multiple):</label>
            <select class="form-select" multiple size="10" @onchange="OnCountriesChanged">
            @foreach (var country in _countries)
        {
   <option value="@country.countryCode">@country.name (@country.countryCode)</option>
          }
 </select>
           <small class="form-text text-muted">Hold Ctrl (Cmd on Mac) and click to select multiple countries</small>
            </div>

       <button class="btn btn-primary" @onclick="OnGetPublicHolidaysCount" disabled="@(!selectedCountryCodes.Any() || selectedYear == 0)">
         Get Public Holidays Count
       </button>

            @if (_publicHolidayCounts != null && _publicHolidayCounts.Any())
            {
        <div class="mt-4">
        <h6>Results for Year @selectedYear (Sorted by Count):</h6>
          <table class="table table-striped table-hover">
             <thead>
          <tr>
          <th>Rank</th>
       <th>Country Code</th>
        <th>Country Name</th>
 <th>Public Holidays (Weekdays Only)</th>
         </tr>
               </thead>
  <tbody>
         @{
           int rank = 1;
   foreach (var count in _publicHolidayCounts)
 {
          var country = _countries.FirstOrDefault(c => c.countryCode == count.CountryCode);
         <tr>
          <td>@rank</td>
            <td><strong>@count.CountryCode</strong></td>
    <td>@(country?.name ?? "Unknown")</td>
<td>
 <span class="badge bg-primary">@count.PublicHolidaysCount</span>
           </td>
 </tr>
rank++;
          }
           }
         </tbody>
             </table>
     </div>
          }
     else if (_publicHolidayCounts != null)
 {
          <div class="alert alert-info mt-3">
           No public holidays found for the selected countries and year.
                </div>
       }
        </div>
    </div>

    <!-- Shared Holidays Section -->
    <div class="card mb-4">
     <div class="card-header">
          <h5>Shared Holidays Between Two Countries</h5>
    </div>
    <div class="card-body">
            <div class="row mb-3">
    <div class="col-md-6">
        <label for="sharedYearInput" class="form-label">Year:</label>
             <input type="number" id="sharedYearInput" class="form-control" @bind="sharedYear" min="2020" max="2030" />
</div>
     </div>

     <div class="row mb-3">
           <div class="col-md-6">
       <label for="country1Select" class="form-label">First Country:</label>
     <select id="country1Select" class="form-select" value="@sharedCountry1" @onchange="OnSharedCountry1Changed">
             <option value="">--- Select first country ---</option>
              @foreach (var country in _countries)
          {
          <option value="@country.countryCode">@country.name</option>
 }
         </select>
   </div>
              <div class="col-md-6">
  <label for="country2Select" class="form-label">Second Country:</label>
       <select id="country2Select" class="form-select" value="@sharedCountry2" @onchange="OnSharedCountry2Changed">
   <option value="">--- Select second country ---</option>
     @foreach (var country in _countries)
   {
          <option value="@country.countryCode">@country.name</option>
         }
 </select>
   </div>
         </div>

            <button class="btn btn-primary" @onclick="OnGetSharedHolidays" 
   disabled="@(string.IsNullOrEmpty(sharedCountry1) || string.IsNullOrEmpty(sharedCountry2) || sharedYear == 0)">
     Find Shared Holidays
     </button>

  @if (_sharedHolidays != null && _sharedHolidays.Any())
    {
  <div class="mt-4">
         <h6>Shared Holidays for Year @sharedYear:</h6>
       <p class="text-muted">
        Comparing <strong>@_countries.FirstOrDefault(c => c.countryCode == sharedCountry1)?.name (@sharedCountry1)</strong> 
and <strong>@_countries.FirstOrDefault(c => c.countryCode == sharedCountry2)?.name (@sharedCountry2)</strong>
</p>
 <table class="table table-striped table-hover">
        <thead>
   <tr>
          <th>Date</th>
      <th>@sharedCountry1 Name</th>
        <th>@sharedCountry2 Name</th>
       </tr>
         </thead>
           <tbody>
  @foreach (var holiday in _sharedHolidays)
   {
  <tr>
     <td><strong>@holiday.Date.ToString("dd MMMM yyyy")</strong></td>
           <td>@holiday.Country1LocalName</td>
      <td>@holiday.Country2LocalName</td>
         </tr>
    }
    </tbody>
  </table>
  <div class="alert alert-success">
     Found <strong>@_sharedHolidays.Count</strong> shared holiday date(s)
  </div>
   </div>
      }
   else if (_sharedHolidays != null)
       {
 <div class="alert alert-info mt-3">
 No shared holidays found for these countries in @sharedYear.
    </div>
       }
     </div>
    </div>
}

@code {
    private List<CountryDto>? _countries;
    private string selectedCountryCode = string.Empty;
    private List<HolidayResultDto>? _results;

    // Public holidays count fields
    private int selectedYear = DateTime.Now.Year;
    private List<string> selectedCountryCodes = new();
    private List<PublicHolidayCountDto>? _publicHolidayCounts;

    // Shared holidays fields
    private int sharedYear = DateTime.Now.Year;
    private string sharedCountry1 = string.Empty;
    private string sharedCountry2 = string.Empty;
    private List<SharedHolidayDto>? _sharedHolidays;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
   _countries = await ApiClient.GetAsync<List<CountryDto>>("api/countries");
        }
        catch (HttpRequestException ex)
        {
        _errorMessage = ex.StatusCode switch
    {
  HttpStatusCode.NotFound => "Resource not found",
      HttpStatusCode.ServiceUnavailable => "Service temporarily unavailable",
  _ => "An error occurred while loading countries. Please try again."
 };
   Logger.LogError(ex, "Failed to load countries");
         _countries = new List<CountryDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = "An unexpected error occurred. Please try again.";
            Logger.LogError(ex, "Unexpected error loading countries");
            _countries = new List<CountryDto>();
   }
    }

    private void OnCountryChanged(ChangeEventArgs e)
 {
    selectedCountryCode = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnGetLastHolidays()
    {
    if (string.IsNullOrEmpty(selectedCountryCode))
  return;

        try
        {
      _results = await ApiClient.GetAsync<List<HolidayResultDto>>($"api/holidays/last-celebrated/{selectedCountryCode}");
            _errorMessage = null;
        }
        catch (Exception ex)
   {
    _errorMessage = "Failed to load holidays. Please try again.";
   Logger.LogError(ex, "Error loading holidays for country {CountryCode}", selectedCountryCode);
    _results = [];
      }
  }

  private void OnCountriesChanged(ChangeEventArgs e)
  {
        if (e.Value is string[] values)
        {
            selectedCountryCodes = values.ToList();
  }
    }

 private async Task OnGetPublicHolidaysCount()
    {
    if (!selectedCountryCodes.Any() || selectedYear == 0)
       return;

        try
  {
      // Build query string with multiple country codes
   var queryString = string.Join("&", selectedCountryCodes.Select(c => $"countryCodes={c}"));
         var url = $"api/holidays/public-count/{selectedYear}?{queryString}";

         _publicHolidayCounts = await ApiClient.GetAsync<List<PublicHolidayCountDto>>(url);
  _errorMessage = null;
      }
     catch (Exception ex)
     {
  _errorMessage = "Failed to load public holidays count. Please try again.";
            Logger.LogError(ex, "Error loading public holidays count for year {Year}", selectedYear);
        _publicHolidayCounts = [];
        }
    }

    private void OnSharedCountry1Changed(ChangeEventArgs e)
    {
 sharedCountry1 = e.Value?.ToString() ?? string.Empty;
    }

    private void OnSharedCountry2Changed(ChangeEventArgs e)
    {
    sharedCountry2 = e.Value?.ToString() ?? string.Empty;
  }

    private async Task OnGetSharedHolidays()
    {
        if (string.IsNullOrEmpty(sharedCountry1) || string.IsNullOrEmpty(sharedCountry2) || sharedYear == 0)
    return;

 if (sharedCountry1.Equals(sharedCountry2, StringComparison.OrdinalIgnoreCase))
{
            _errorMessage = "Please select two different countries.";
   return;
   }

try
   {
          var url = $"api/holidays/shared/{sharedYear}?countryCode1={sharedCountry1}&countryCode2={sharedCountry2}";
    _sharedHolidays = await ApiClient.GetAsync<List<SharedHolidayDto>>(url);
            _errorMessage = null;
        }
        catch (Exception ex)
     {
     _errorMessage = "Failed to load shared holidays. Please try again.";
     Logger.LogError(ex, "Error loading shared holidays for {Country1} and {Country2} in {Year}", sharedCountry1, sharedCountry2, sharedYear);
     _sharedHolidays = [];
        }
    }
}