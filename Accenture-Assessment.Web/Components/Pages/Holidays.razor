@page "/holidays"
@rendermode InteractiveServer
@using Accenture_Assesment.Web
@using Accenture_Assessment.Contracts.Dtos
@inject ApplicationApiClient ApiClient

<h3>Holidays</h3>

@if (_countries == null)
{
    <p><em>Loading countries...</em></p>
}
else if (!_countries.Any())
{
    <p>No countries available.</p>
}
else
{
    <!-- Last Celebrated Holidays Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Last Celebrated Holidays</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="countrySelect" class="form-label">Select a Country:</label>
                <select id="countrySelect" class="form-select" value="@selectedCountryCode" @onchange="OnCountryChanged">
                    <option value="">--- Select a country ---</option>
                    @foreach (var country in _countries)
                    {
                        <option value="@country.countryCode">@country.name</option>
                    }
                </select>
                <button class="btn btn-primary mt-2" @onclick="OnGetLastHolidays" disabled="@string.IsNullOrEmpty(selectedCountryCode)">
                    Find holidays
                </button>
            </div>

            <div class="mb-3">
                @if (_results == null || !_results.Any())
                {
                    <em>No results</em>
                }
                else
                {
                    <h6>Last Celebrated Holidays:</h6>
                    @foreach (var holiday in _results)
                    {
                        <div class="mb-2">
                            <strong>@holiday.Name</strong> (@holiday.LocalName) - @holiday.Date.ToShortDateString()
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Public Holidays Count Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5>Public Holidays Count (Excluding Weekends)</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="yearInput" class="form-label">Year:</label>
                    <input type="number" id="yearInput" class="form-control" @bind="selectedYear" min="2020" max="2030" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Select Countries (hold Ctrl to select multiple):</label>
                <select class="form-select" multiple size="10" @onchange="OnCountriesChanged">
                    @foreach (var country in _countries)
                    {
                        <option value="@country.countryCode">@country.name (@country.countryCode)</option>
                    }
                </select>
                <small class="form-text text-muted">Hold Ctrl (Cmd on Mac) and click to select multiple countries</small>
            </div>

            <button class="btn btn-primary" @onclick="OnGetPublicHolidaysCount" disabled="@(!selectedCountryCodes.Any() || selectedYear == 0)">
                Get Public Holidays Count
            </button>

            @if (_publicHolidayCounts != null && _publicHolidayCounts.Any())
            {
                <div class="mt-4">
                    <h6>Results for Year @selectedYear (Sorted by Count):</h6>
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Country Code</th>
                                <th>Country Name</th>
                                <th>Public Holidays (Weekdays Only)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                                foreach (var count in _publicHolidayCounts)
                                {
                                    var country = _countries.FirstOrDefault(c => c.countryCode == count.CountryCode);
                                    <tr>
                                        <td>@rank</td>
                                        <td><strong>@count.CountryCode</strong></td>
                                        <td>@(country?.name ?? "Unknown")</td>
                                        <td>
                                            <span class="badge bg-primary">@count.PublicHolidaysCount</span>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_publicHolidayCounts != null)
            {
                <div class="alert alert-info mt-3">
                    No public holidays found for the selected countries and year.
                </div>
            }
        </div>
    </div>
}

@code {
    private List<CountryDto>? _countries;
    private string selectedCountryCode = string.Empty;
    private List<HolidayResultDto>? _results;

    // Public holidays count fields
    private int selectedYear = DateTime.Now.Year;
    private List<string> selectedCountryCodes = new();
    private List<PublicHolidayCountDto>? _publicHolidayCounts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _countries = await ApiClient.GetAsync<List<CountryDto>>("api/countries");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading countries: {ex.Message}");
            _countries = new List<CountryDto>();
        }
    }

    private void OnCountryChanged(ChangeEventArgs e)
    {
        selectedCountryCode = e.Value?.ToString() ?? string.Empty;
    }

    private async Task OnGetLastHolidays()
    {
        if (string.IsNullOrEmpty(selectedCountryCode))
            return;

        try
        {
            _results = await ApiClient.GetAsync<List<HolidayResultDto>>($"api/holidays/last-celebrated/{selectedCountryCode}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading holidays: {ex.Message}");
            _results = [];
        }
    }

    private void OnCountriesChanged(ChangeEventArgs e)
    {
        if (e.Value is string[] values)
        {
            selectedCountryCodes = values.ToList();
        }
    }

    private async Task OnGetPublicHolidaysCount()
    {
        if (!selectedCountryCodes.Any() || selectedYear == 0)
            return;

        try
        {
            // Build query string with multiple country codes
            var queryString = string.Join("&", selectedCountryCodes.Select(c => $"countryCodes={c}"));
            var url = $"api/holidays/public-count/{selectedYear}?{queryString}";

            _publicHolidayCounts = await ApiClient.GetAsync<List<PublicHolidayCountDto>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading public holidays count: {ex.Message}");
            _publicHolidayCounts = [];
        }
    }
}